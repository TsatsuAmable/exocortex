{
  "schema_version": 2,
  "components": {
    "goms": {
      "source": "goms-v2",
      "install": "goms-v2",
      "entrypoint": "mcp_server.py",
      "health": [
        "python",
        "-m",
        "unittest",
        "-q",
        "test_hermes_goms_config.py"
      ]
    },
    "model_router": {
      "source": "compute/model-routing",
      "install": "model-routing",
      "entrypoint": "router.py",
      "health": [
        "python",
        "test_router.py"
      ]
    },
    "hermes_profile": {
      "source": "hermes",
      "install": "hermes",
      "entrypoint": "install_profile.py",
      "health": [
        "python",
        "install_profile.py",
        "--check"
      ]
    },
    "delivery_controller": {
      "source": "delivery-controller",
      "install": "delivery-controller",
      "entrypoint": "delivery.py",
      "health": [
        "python",
        "-m",
        "unittest",
        "-q",
        "test_delivery.py",
        "test_workspace.py"
      ]
    },
    "survivability": {
      "source": "survivability",
      "install": "survivability",
      "entrypoint": "survivability_audit.py",
      "health": [
        "python",
        "-m",
        "unittest",
        "-q",
        "test_survivability_audit.py"
      ]
    },
    "runtime_scripts": {
      "source": "scripts",
      "install": "scripts",
      "entrypoint": "submit_scheduled_intent.py",
      "health": []
    },
    "scheduled_intents": {
      "source": "config/scheduled-intents",
      "install": "config/scheduled-intents",
      "entrypoint": "exocortex-self-improvement.json",
      "health": []
    },
    "service_deploy": {
      "source": "deploy",
      "install": "deploy",
      "entrypoint": "launchd/service-inventory.example.json",
      "health": []
    }
  },
  "external_dependencies": {
    "hermes_agent": {
      "kind": "agent_runtime",
      "repository": "https://github.com/NousResearch/hermes-agent",
      "known_good_commit": "f6ddd89692dff1f900983a16208f39a1485a14eb",
      "known_good_version": "0.21.1",
      "qualified_patches": [
        "hermes/patches/context-safe-main-fallback.patch",
        "hermes/patches/exocortex-control-turn-hard-guard.patch"
      ]
    },
    "remote_commander": {
      "kind": "machine_effector",
      "contract": "MCP",
      "default_url": "http://127.0.0.1:8771/mcp"
    },
    "ollama": {
      "kind": "model_runtime",
      "default_url": "http://127.0.0.1:11434"
    },
    "neo4j": {
      "kind": "replaceable_graph_projection",
      "default_bolt_url": "bolt://127.0.0.1:7687"
    },
    "tailscale": {
      "kind": "private_network",
      "required_for": "remote/private-fabric routes only"
    },
    "github_cli": {
      "kind": "delivery_external_authority",
      "command": "gh"
    },
    "docker": {
      "kind": "hermes_sandbox_runtime",
      "command": "docker"
    }
  },
  "state_roots": {
    "goms": {
      "env": "GOMS_HOME",
      "reference_macos": "~/Library/Application Support/Aineko/GOMS",
      "git": false,
      "canonical": true
    },
    "hermes_profile": {
      "reference": "~/.hermes/profiles/gsvaineko",
      "git": false,
      "canonical": "runtime continuity only"
    },
    "hermes_authority": {
      "reference": "~/.hermes/authority",
      "git": false,
      "canonical": "local authority/audit"
    }
  },
  "service_inventory": "deploy/launchd/service-inventory.example.json",
  "reconstruction": {
    "guide": "docs/reconstruction/REBUILD_FROM_GITHUB.md",
    "acceptance": "docs/reconstruction/ACCEPTANCE_CHECKLIST.md",
    "state_boundary": "docs/reconstruction/STATE_AND_SECRETS.md",
    "self_check": "scripts/reconstruction_check.py"
  }
}
