{
  "name": "exocortex-pr-autopilot-v1",
  "repository": "TsatsuAmable/exocortex",
  "autopilot_enabled": true,
  "auto_merge": true,
  "allowed_base_branches": [
    "main"
  ],
  "max_repair_attempts": 3,
  "escalate_on": [
    "architecture",
    "intent",
    "authority",
    "security",
    "repeated_failure"
