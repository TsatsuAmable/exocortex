  "blocked_paths": [
    ".github",
    "SECURITY.md"
  ],
  "local_verification": [
    "python scripts/reconstruction_check.py",
    "python -m unittest -q test_exocortex_deploy.py",
    "python compute/model-routing/test_router.py"
  ],
  "auto_repair": true,
  "source_path": "/Users/tsatsuamable/Documents/aineko-infrastructure",
  "repair_timeout_seconds": 1200
}
