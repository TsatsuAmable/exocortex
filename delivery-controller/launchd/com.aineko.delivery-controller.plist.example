<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aineko.delivery-controller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/tsatsuamable/Library/Application Support/Aineko/delivery-controller/delivery.py</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/tsatsuamable/Library/Logs/Aineko/delivery-controller.log</string>
  <key>StandardErrorPath</key><string>/Users/tsatsuamable/Library/Logs/Aineko/delivery-controller.err.log</string>
</dict>
</plist>
