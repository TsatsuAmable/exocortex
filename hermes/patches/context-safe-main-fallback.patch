+++ b/tests/run_agent/test_fallback_request_pressure.py
@@ -0,0 +1,113 @@
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from agent.error_classifier import FailoverReason
+from agent.turn_api_error import settle_unrecovered_error
+from agent.turn_recovery import route_classified_error
+
+
+class _Agent:
+    provider = "custom"
+    model = "primary"
+    base_url = "http://127.0.0.1:11434/v1"
+    compression_enabled = True
+    tools = []
+    _fallback_index = 0
+    _fallback_chain = [{"provider": "custom", "model": "small"}]
+    _credential_pool = None
+
+    def __init__(self):
+        self.seen_required_tokens = []
+        self.status = []
+
+    def _has_pending_fallback(self):
+        return True
+
+    def _buffer_status(self, message):
+        self.status.append(message)
+
+    def _try_activate_fallback(self, reason=None, required_context_tokens=None):
+        self.seen_required_tokens.append(required_context_tokens)
+        return True
+
+
+def _classified(reason=FailoverReason.unknown, *, retryable=False):
+    return SimpleNamespace(
+        reason=reason,
+        retryable=retryable,
+        should_compress=False,
+        is_auth=False,
+    )
+
+
+def test_nonretryable_fallback_uses_authoritative_request_pressure():
+    agent = _Agent()
+    retry = SimpleNamespace(copilot_stale_cred_retry_attempted=False)
+    error = SimpleNamespace(status_code=400)
+
+    with patch("agent.conversation_loop._arm_fallback_restart", return_value="sys"):
+        verdict = settle_unrecovered_error(
+            agent,
+            api_error=error,
+            classified=_classified(),
+            _retry=retry,
+            status_code=400,
+            error_msg="bad request",
+            is_context_length_error=False,
+            is_rate_limited=False,
+            _is_zai_coding_overload=False,
+            _provider="custom",
+            _base=agent.base_url,
+            _model=agent.model,
+            messages=[],
+            api_messages=[{"role": "user", "content": "x"}],
+            api_kwargs={},
+            active_system_prompt="sys",
+            conversation_history=[],
+            approx_tokens=30_000,
+            request_pressure_tokens=121_481,
+            retry_count=1,
+            max_retries=3,
+            compression_attempts=0,
+            api_call_count=1,
+        )
+
+    assert verdict.action == "break"
+    assert agent.seen_required_tokens == [121_481]
+
+
+def test_eager_fallback_uses_authoritative_request_pressure():
+    agent = _Agent()
+    retry = SimpleNamespace(auth_failover_attempted=False)
+    error = SimpleNamespace(status_code=429)
+
+    with (
+        patch("agent.conversation_loop._arm_fallback_restart", return_value="sys"),
+        patch("run_agent._pool_may_recover_from_rate_limit", return_value=False),
+    ):
+        verdict = route_classified_error(
+            agent,
+            error,
+            _classified(FailoverReason.rate_limit, retryable=True),
+            retry,
+            error_msg="rate limit",
+            error_context=None,
+            recovered_with_pool=False,
+            base_url=agent.base_url,
+            model=agent.model,
+            messages=[],
+            api_messages=[{"role": "user", "content": "x"}],
+            system_message="",
+            active_system_prompt="sys",
+            conversation_history=[],
+            retry_count=1,
+            max_retries=3,
+            compression_attempts=0,
+            max_compression_attempts=3,
+            api_call_count=1,
+            effective_task_id=None,
+            request_pressure_tokens=121_481,
+        )
+
+    assert verdict.action == "break"
+    assert agent.seen_required_tokens == [121_481]
