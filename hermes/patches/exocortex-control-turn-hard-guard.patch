diff --git a/gateway/run_turn_runner.py b/gateway/run_turn_runner.py
index 2a804508..673cf635 100644
--- a/gateway/run_turn_runner.py
+++ b/gateway/run_turn_runner.py
@@ -35,6 +35,21 @@ if TYPE_CHECKING:  # string annotations only; never imported at runtime (cycle)
 logger = logging.getLogger("gateway.run")
 
 
+def _effective_turn_max_iterations(configured: int, override: Optional[int]) -> int:
+    """Clamp a per-turn iteration override without ever widening the configured budget."""
+    try:
+        base = max(1, int(configured))
+    except Exception:
+        base = 1
+    if override is None:
+        return base
+    try:
+        cap = max(1, int(override))
+    except Exception:
+        return base
+    return min(base, cap)
+
+
 class _ExecApprovalDeclined(RuntimeError):
     """The connector refused the approval card's destination.
 
