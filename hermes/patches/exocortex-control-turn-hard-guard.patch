         # removing this in-process gateway write does not affect any of them.
         platform_key = "cli" if ctx.source.platform == Platform.LOCAL else ctx.source.platform.value
         combined_ephemeral = self._combined_ephemeral_prompt()
-        max_iterations = _current_max_iterations()
+        max_iterations = _effective_turn_max_iterations(
+            _current_max_iterations(), getattr(ctx, "max_iterations_override", None)
+        )
+        if getattr(ctx, "max_iterations_override", None) is not None:
+            logger.info(
+                "Per-turn iteration cap active: configured=%s effective=%s session=%s",
+                _current_max_iterations(), max_iterations, ctx.session_key or "",
+            )
         try:
             model, runtime_kwargs = runner._resolve_session_agent_runtime(
