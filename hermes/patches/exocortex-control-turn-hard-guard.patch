 logger = logging.getLogger("gateway.run")
 
 
+_EXOCORTEX_CONTROL_TURNS = {
+    "status": {"status", "status update", "status check", "what is the status", "what's the status", "whats the status"},
+    "what_next": {"what next", "what's next", "whats next", "what now", "next"},
+    "proceed": {"proceed"},
+}
+
+_EXOCORTEX_CONTROL_NOTES = {
+    "status": (
+        "[Exocortex control turn: STATUS] Observational only. Batch independent read-only checks. "
+        "Do not restart services, edit files/config, mutate git, install software, send messages, or "
+        "perform discovered remediation. Mutable facts stated as current must be observed in this turn; "
+        "otherwise mark them last-known or omit them. The only allowed operational write is submitting "
+        "a durable remediation intent to GOMS. Answer and stop within this turn's enforced iteration cap."
+    ),
+    "what_next": (
+        "[Exocortex control turn: WHAT NEXT] Decision only. Inspect enough current state to identify one "
+        "concrete next action, report it compactly, and do not execute it. Stop within this turn's enforced "
+        "iteration cap."
+    ),
+    "proceed": (
+        "[Exocortex control turn: PROCEED] Execute the most recently selected unambiguous action only if it "
+        "can be completed and verified within this turn's enforced iteration cap. Otherwise submit or route "
+        "a durable bounded-worker intent and return once delegation is verified."
+    ),
+}
+
+
+def _exocortex_control_turn_policy(message: Any, user_config: Any) -> tuple[Optional[str], Optional[int], Optional[str]]:
+    """Return (kind, max_iterations, one-shot note) for an opted-in exact control turn."""
+    if not isinstance(user_config, dict):
+        return None, None, None
+    agent_cfg = user_config.get("agent") or {}
+    if not isinstance(agent_cfg, dict) or agent_cfg.get("interactive_control_contract") != "exocortex":
+        return None, None, None
+    normalized = " ".join(str(message or "").strip().lower().split()).rstrip("?!.,;: ")
+    for kind, phrases in _EXOCORTEX_CONTROL_TURNS.items():
+        if normalized in phrases:
+            return kind, 3, _EXOCORTEX_CONTROL_NOTES[kind]
+    return None, None, None
+
+
