diff --git a/tests/gateway/test_exocortex_control_turn_policy.py b/tests/gateway/test_exocortex_control_turn_policy.py
new file mode 100644
index 00000000..05d9eb30
--- /dev/null
+++ b/tests/gateway/test_exocortex_control_turn_policy.py
@@ -0,0 +1,45 @@
+from gateway.run_turn import _exocortex_control_turn_policy
+from gateway.run_turn_runner import _effective_turn_max_iterations
+
+
+def _cfg(enabled=True):
+    return {"agent": {"interactive_control_contract": "exocortex" if enabled else "other"}}
+
+
+def test_status_control_turn_is_exact_and_capped():
+    kind, cap, note = _exocortex_control_turn_policy("  Status?!  ", _cfg())
+    assert kind == "status"
+    assert cap == 3
+    assert "Observational only" in note
+    assert "Do not restart services" in note
+
+
+def test_next_and_proceed_control_turns():
+    kind, cap, note = _exocortex_control_turn_policy("What's next?", _cfg())
+    assert (kind, cap) == ("what_next", 3)
+    assert "do not execute it" in note
+
+    kind, cap, note = _exocortex_control_turn_policy("What now?", _cfg())
+    assert (kind, cap) == ("what_next", 3)
+    assert "do not execute it" in note
+
+    kind, cap, note = _exocortex_control_turn_policy("Proceed.", _cfg())
+    assert (kind, cap) == ("proceed", 3)
+    assert "durable bounded-worker intent" in note
+
+
+def test_compound_messages_do_not_trigger_control_turn_policy():
+    assert _exocortex_control_turn_policy("Status and fix anything broken", _cfg()) == (None, None, None)
+    assert _exocortex_control_turn_policy("Proceed with PR 815 and merge it", _cfg()) == (None, None, None)
+
+
+def test_policy_is_profile_opt_in():
+    assert _exocortex_control_turn_policy("Status", _cfg(False)) == (None, None, None)
+    assert _exocortex_control_turn_policy("Status", {}) == (None, None, None)
+
+
+def test_iteration_override_only_clamps():
+    assert _effective_turn_max_iterations(60, 3) == 3
+    assert _effective_turn_max_iterations(2, 3) == 2
+    assert _effective_turn_max_iterations(60, None) == 60
+    assert _effective_turn_max_iterations(60, 0) == 1
