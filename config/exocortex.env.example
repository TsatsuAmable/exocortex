# Machine-local Exocortex configuration. Do not put secret values in Git.

EXOCORTEX_PREFIX="$HOME/.local/share/exocortex"
EXOCORTEX_GOMS_DATA_ROOT="$HOME/Library/Application Support/Aineko/GOMS"
HERMES_PROFILE_HOME="$HOME/.hermes/profiles/gsvaineko"
HERMES_AUTHORITY_HOME="$HOME/.hermes/authority"

OLLAMA_BASE_URL="http://127.0.0.1:11434"
NEO4J_URI="bolt://127.0.0.1:7687"

REMOTE_COMMANDER_URL="http://127.0.0.1:8771/mcp"
REMOTE_COMMANDER_TOKEN_FILE="<LOCAL_SECRET_PATH>"

GOMS_MANFRED_READ_HOST="127.0.0.1"
GOMS_MANFRED_READ_CLIENT="<TAILSCALE_OR_ALLOWED_CLIENT_IP>"
GOMS_MANFRED_AUTHORITY_HOST="<PRIVATE_BIND_IP>"
GOMS_MANFRED_AUTHORITY_CLIENT="<ALLOWED_CLIENT_IP>"
GOMS_MANFRED_READ_TOKEN_FILE="<LOCAL_SECRET_PATH>"
GOMS_MANFRED_AUTHORITY_TOKEN_FILE="<LOCAL_SECRET_PATH>"
GOMS_MANFRED_AUTHORITY_PUBLIC_KEY_FILE="<LOCAL_PUBLIC_KEY_PATH>"

# Provider credentials/OAuth stay in provider-specific local stores.
