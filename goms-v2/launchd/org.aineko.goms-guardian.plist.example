<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.aineko.goms-guardian</string>
<key>ProgramArguments</key><array>
<string>/bin/zsh</string>
<string>-lc</string>
<string>/usr/bin/python3 "${HOME}/Library/Application Support/Aineko/GOMS/guardian_packet.py" &amp;&amp; /usr/bin/python3 "${HOME}/Library/Application Support/Aineko/GOMS/guardian_review.py"</string>
</array>
<key>WorkingDirectory</key><string>${HOME}/Library/Application Support/Aineko/GOMS</string>
<key>StartInterval</key><integer>86400</integer>
<key>RunAtLoad</key><false/>
<key>StandardOutPath</key><string>${HOME}/Library/Logs/aineko-goms-guardian.log</string>
<key>StandardErrorPath</key><string>${HOME}/Library/Logs/aineko-goms-guardian.err</string>
</dict></plist>