<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.aineko.goms-infrastructure-health</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/python3</string>
<string>${HOME}/Library/Application Support/Aineko/GOMS/infrastructure_health_controller.py</string>
</array>
<key>WorkingDirectory</key><string>${HOME}/Library/Application Support/Aineko/GOMS</string>
<key>StartInterval</key><integer>60</integer>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>${HOME}/Library/Logs/aineko-goms-infrastructure-health.log</string>
<key>StandardErrorPath</key><string>${HOME}/Library/Logs/aineko-goms-infrastructure-health.err</string>
</dict></plist>