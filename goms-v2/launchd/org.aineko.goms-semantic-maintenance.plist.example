<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.aineko.goms-semantic-maintenance</string>
  <key>ProgramArguments</key>
  <array>
    <string>${HOME}/Library/Application Support/Aineko/venv/bin/python</string>
    <string>${HOME}/Library/Application Support/Aineko/GOMS/semantic_maintenance.py</string>
  </array>
  <key>WorkingDirectory</key><string>${HOME}/Library/Application Support/Aineko/GOMS</string>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>${HOME}/Library/Logs/aineko-goms-semantic.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/aineko-goms-semantic.err</string>
</dict>
</plist>