<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.aineko.goms-manfred-control</string>
<key>ProgramArguments</key><array><string>${HOME}/Library/Application Support/Aineko/GOMS/start_manfred_control.sh</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>5</integer>
<key>StandardOutPath</key><string>${HOME}/Library/Logs/Aineko/goms-manfred-control.log</string>
<key>StandardErrorPath</key><string>${HOME}/Library/Logs/Aineko/goms-manfred-control.err.log</string>
</dict></plist>
